# Copy into ~/.dbt/profiles.yml
#
# The READ projects (sources) are separate; this is only the WRITE target.
#   researcher-360-prod-e7fd74be   ORCID + CDP       (read access required)
#   ri-data-engineering-dd4c0eca   ROR registry      (read access required)
#   datasn-rm-live                 embedding model   (read access required)

orcid_role_agent:
  target: dev
  outputs:
    dev:
      type: bigquery
      method: oauth
      project: dat-analytics-eng-ec869189
      dataset: orcid_role_agent_dev      # -> orcid_role_agent_dev_raw, _staging ...
      location: EU
      threads: 8
      priority: interactive
      job_execution_timeout_seconds: 1800

    prod:
      type: bigquery
      method: service-account
      keyfile: /path/to/keyfile.json
      project: dat-analytics-eng-ec869189
      dataset: orcid_role_agent          # -> orcid_role_agent_raw, _staging ...
      location: EU
      threads: 16
