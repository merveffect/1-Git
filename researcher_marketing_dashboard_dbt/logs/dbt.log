    `snproject-cbb9ca25`.`dbt_dev_ga4_ria_researcher_report`.`j7`
     
  WHERE date BETWEEN DATE('2024-01-01')
                  AND DATE('2025-09-30')

    )
SELECT
  *
FROM
  main
UNPIVOT
  (numbers FOR metric IN (sessions,
      ViewB2CBlogPage))
    );
  
