WITH
  main AS (
  SELECT
    *
  FROM
    `snproject-cbb9ca25`.`dbt_dev_ga4_ria_researcher_report`.`j2`
    
  
  
  WHERE date BETWEEN 
    
      DATE_SUB(CURRENT_DATE(), INTERVAL 2 DAY)
    
    AND
    
      DATE_SUB(CURRENT_DATE(), INTERVAL 2 DAY)
    

    ),
  countries AS (
  SELECT
    DISTINCT LOWER(isoalphatwo) AS country_isoalphatwo,
    country
  FROM
    `snproject-cbb9ca25`.`ga4_ria_researcher_report`.`countries` ),
  joined_data AS (
  SELECT
    *
  FROM
    main
  LEFT JOIN
    countries
  ON
    main.isoalphatwo = countries.country_isoalphatwo ),
  required_data AS (
  SELECT
    date,
    campaign,
    SOURCE,
    medium,
    main_channels,
    sub_channels,
    country,
    isoalphatwo,
    world_region,
    journal_title,
    journal_id,
    business_model,
    main_discipline,
    main_group,
    portfolio,
    imprint,
    kpi_marbl_leads,
    Sessions,
    pi_publishing_guidelines,
    EngagedSessions,
    ELS,
    snapp_submission_complete,
    content_consumption,
    reach_india_apc_thankyou,
    reach_oa_general,
    snapp_submission_start,
    kpi_submit_click,
    pi_reach_fta,
    kpi_reach_submission_guideline_pages,
    kpi_reach_about_pages,
    pi_contact_an_editor,
