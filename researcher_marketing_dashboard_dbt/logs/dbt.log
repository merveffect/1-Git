      nav_sign_up_for_alerts ),
    SUM(kpi_marbl_leads) AS kpi_marbl_leads,
    SUM(Sessions) AS Sessions,
    SUM(ga4_reach_books_publishing_guidelines) AS ga4_reach_books_publishing_guidelines,
