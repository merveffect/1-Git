# Copy this file to .env and fill in your values

# Path to your dbt project root (the folder containing dbt_project.yml)
# Leave empty if you want to set it from the Settings page in the UI instead
DBT_PROJECT_PATH=/Users/you/your-dbt-project

# SQLite database file location (default is fine for local use)
DATABASE_URL=sqlite:///./monitor.db

# How often monitors run (in minutes)
SCHEDULER_INTERVAL_MINUTES=60

# Default alert thresholds
DEFAULT_FRESHNESS_THRESHOLD_HOURS=24
DEFAULT_VOLUME_ZSCORE_THRESHOLD=3.0
DEFAULT_NULL_RATE_THRESHOLD_PCT=5.0
