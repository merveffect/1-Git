    create or replace table `dat-analytics-eng-ec869189`.`dev_audience_explorer_analytics_dbt_staging`.`stg_unnest_new_columns`
      
    
    

    
    OPTIONS(
      description=""""""
    )
    as (
      with base as ( 

select anonymousID, submissions, lifetime_aggregations

from `cdp-data-55497fbb`.`prod_cdp_cep_dbt_presentation`.`segment_user_profile_sync` 
)


select
  b.anonymousID,

  -- submissions: ARRAY<STRUCT> → UNNEST
  s.submission_id,
  s.journal_id,
  s.journal_title,
  s.submission_title,
  s.final_decision,
  s.is_oa_journal,
  s.is_last_submission,
  s.submission_timestamp,
  s.decision_timestamp,
  s.imprint,

  -- all_imprints:
  b.lifetime_aggregations.all_imprints.total_submissions    as all_imprints_total_submissions,
  b.lifetime_aggregations.all_imprints.total_accepts        as all_imprints_total_accepts,
  b.lifetime_aggregations.all_imprints.total_rejects        as all_imprints_total_rejects,
  b.lifetime_aggregations.all_imprints.total_oa_submissions as all_imprints_total_oa_submissions

from base b
left join unnest(ifnull(b.submissions, [])) as s
    );
  
