  FROM `dat-analytics-eng-ec869189`.`dev_audience_explorer_analytics_dbt_raw`.`raw_user_traits` AS t
  CROSS JOIN UNNEST(JSON_EXTRACT_ARRAY(t.value, '$')) AS item
  WHERE t.name = 'submissions'
),

-- kişi başına tek satır: en güncel submission (deterministic)
last_submission AS (
  SELECT
    canonical_segment_id,
    (ARRAY_AGG(STRUCT(
      imprint,
      journal_id,
      journal_title,
      submission_timestamp
    ) ORDER BY submission_timestamp DESC LIMIT 1))[OFFSET(0)] AS s
  FROM submissions
  WHERE canonical_segment_id IS NOT NULL
  GROUP BY canonical_segment_id
)

SELECT
  p.*,
  ls.s.imprint             AS imprint,
  ls.s.journal_id          AS journal_id,
  ls.s.journal_title       AS journal_title,
  ls.s.submission_timestamp AS submission_timestamp
FROM pivoted p
LEFT JOIN last_submission ls
USING (canonical_segment_id)
    );
  
