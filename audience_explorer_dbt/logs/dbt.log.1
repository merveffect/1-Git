select * from (
        with base as (
  select
  
  distinct name as column_names
  
  from `dat-analytics-eng-ec869189`.`dev_audience_explorer_analytics_dbt_raw`.`raw_user_traits`
),

subs AS (
Select 
anonymous_id,

JSON_VALUE_ARRAY(SAFE_CAST(value AS JSON), '$') AS submissions
from base 
where name = 'submissions'

)

  select
  b.*,

  -- submissions: ARRAY<STRUCT> → UNNEST

  JSON_VALUE(s, '$.journal_id')   AS journal_id,
  JSON_VALUE(s, '$.journal_title') AS journal_title,
  JSON_VALUE(s, '$.submission_timestamp')   AS submission_timestamp,
  JSON_VALUE(s, '$.imprint')   AS imprint


  -- all_imprints:
  b.lifetime_aggregations.all_imprints.total_submissions    as all_imprints_total_submissions,
  b.lifetime_aggregations.all_imprints.total_accepts        as all_imprints_total_accepts,
  b.lifetime_aggregations.all_imprints.total_rejects        as all_imprints_total_rejects,
  b.lifetime_aggregations.all_imprints.total_oa_submissions as all_imprints_total_oa_submissions

from base b
left join subs ON subs.id = b.id
left join unnest(ifnull(subs.submissions, [])) as s
    ) as __dbt_sbq
    where false and current_timestamp() = current_timestamp()
    limit 0

