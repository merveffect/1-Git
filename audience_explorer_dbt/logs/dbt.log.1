    OPTIONS(
      description=""""""
    )
    as (
      with base as ( 

select anonymousID, submissions, oa_agreemenets

from `cdp-data-55497fbb`.`prod_cdp_cep_dbt_presentation`.`segment_user_profile_sync` 
)


--unnest submissions

submissions_unnested as (
  select
    b.anonymousID,
    s.*,
    off as sub_idx
  from base b
  left join unnest(b.submissions) as s with offset off
),

--unnest oa_agreements

oa_agreements_unnested as(

select 
b.anonymousID,
oa.*,
off as oa_idx
from base b
left join unnest(b.oa_agreements) as oa with offset off
)

select 

coalesce(s.anonymousID, oa.anonymousID) as anonymousID,
  s.* except(sub_idx),
  oa.* except(oa_idx)
from submissions_unnested
full outer join oa_agreements_unnested
  on oa.anonymousID = s.anonymousID
 and oa.oa_idx = s.sub_idx
    );
  
