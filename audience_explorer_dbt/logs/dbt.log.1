    create or replace table `dat-analytics-eng-ec869189`.`dev_audience_explorer_analytics_dbt_staging`.`stg_unnest_new_columns`
      
    
    

    
    OPTIONS(
      description=""""""
    )
    as (
      with base as ( 

select * from `dat-analytics-eng-ec869189`.`dev_audience_explorer_analytics_dbt_raw`.`raw_user_traits`
where name = 'lifetime_aggregations'

),

parsed as (
  select
    canonical_segment_id,
    safe.parse_json(value) as j
  from base
),

ai as (
  select
    canonical_segment_id,
    case
      when json_value(j, '$.all_imprints') is not null
           and safe.parse_json(json_value(j, '$.all_imprints')) is not null
        then safe.parse_json(json_value(j, '$.all_imprints'))
      when json_query(j, '$.all_imprints') is not null
        then safe.parse_json(to_json_string(json_query(j, '$.all_imprints')))
      else null
    end as ai
  from parsed
)

select
  canonical_segment_id,
  cast(json_value(ai, '$.total_accepts')        as int64) as total_accepts,
