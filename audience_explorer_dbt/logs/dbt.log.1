  CAST(JSON_VALUE(p.ai, '$.total_accepts')        AS INT64) AS total_accepts,
  CAST(JSON_VALUE(p.ai, '$.total_rejects')        AS INT64) AS total_rejects,
  CAST(JSON_VALUE(p.ai, '$.total_oa_submissions') AS INT64) AS total_oa_submissions,
