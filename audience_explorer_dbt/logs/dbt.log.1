c_sign_up_events','country','predict_new_snapp_submission','rm_authors_con_dec_display','nature_china','one_time_author_1_publication','avg_if','power_authors_positive','list_journals_submissions_alltime','control_cells_rg_2025','anonymous_id','article_submission_last_180_d_scirep','count_submguidelines_last_90_days','article_submission_last_180_d_10668','users_with_nature_affinity','percent_oa','role','collections_sci_rep_1_x_ready_to_submit_or_1_x_submit_manuscript','count_about_last_30_d','oa_agreement_springer_flag1','overlap_between_marketing_opt_in_submitters','authors_that_cost_money','marketing_opt_ins_have_visited_the_source','article_submission_last_180_d_10639','count_research_integrity_last_180_d','oa_articles','sn_journal_submitters_past_month','sn_journal_submitter','oa_agreement_nature_url1','power_author_neutral','sn_fan_occasional_author','h_index','oa_agreement_bmc_url1','oa_agreement_nature_flag1','count_submguidelines_last_30_d','researcher_id','complete_mpc_profiles','author_group_nature','markeing_optin','predict_all_submission_existing_authors','email','article_submission_last_180_d_41392','sn_journal_authors','count_submission_complete_last_180_d','country_author','loyalty_sci_rep_or_any_journal_1_x_article_published_over_90_days','years_active','occasional_author_2_10_publications','non_sn_authors','list_keywords_dois_last_60_d','list_doi_last_90_d','user_id') )
),

submissions AS (
  SELECT
    t.canonical_segment_id,
    JSON_VALUE(item, '$.imprint')                           AS imprint,
    JSON_VALUE(item, '$.journal_id')                        AS journal_id,
    JSON_VALUE(item, '$.journal_title')                     AS journal_title,
    SAFE.TIMESTAMP(JSON_VALUE(item, '$.submission_timestamp')) AS submission_timestamp
  FROM `dat-analytics-eng-ec869189`.`dev_audience_explorer_analytics_dbt_raw`.`raw_user_traits` AS t
  CROSS JOIN UNNEST(JSON_EXTRACT_ARRAY(t.value, '$')) AS item
  WHERE t.name = 'submissions'
),

-- kişi başına tek satır: en güncel submission (deterministic)
last_submission AS (
  SELECT
    canonical_segment_id,
    (ARRAY_AGG(STRUCT(
      imprint,
      journal_id,
      journal_title,
      submission_timestamp
    ) ORDER BY submission_timestamp DESC LIMIT 1))[OFFSET(0)] AS s
  FROM submissions
  WHERE canonical_segment_id IS NOT NULL
  GROUP BY canonical_segment_id
)

SELECT
  p.*,
  ls.s.imprint             AS imprint,
  ls.s.journal_id          AS journal_id,
  ls.s.journal_title       AS journal_title,
  ls.s.submission_timestamp AS submission_timestamp
FROM pivoted p
LEFT JOIN last_submission ls
USING (canonical_segment_id)
    );
  
